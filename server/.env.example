PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/wtl_inventory
# Set a private random JWT_SECRET of at least 16 characters before starting the API.
# JWT_SECRET=
CLIENT_URL=http://localhost:5173
UPLOADS_DIR=uploads
# Set these three values privately before starting against an empty database.
# INITIAL_ADMIN_NAME=
# INITIAL_ADMIN_EMAIL=
# INITIAL_ADMIN_PASSWORD=Use-a-unique-password-of-at-least-16-characters
